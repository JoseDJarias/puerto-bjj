<div class="<%= css('program-page') %>">
  <div class="<%= css('program-page-container') %>">
    <!-- 1. Hero Section -->
    <section class="<%= css('hero') %>" aria-labelledby="<%= section_id('hero-title') %>">
      <div class="<%= css('hero-content') %>">
        <h1 id="<%= section_id('hero-title') %>" class="<%= css('hero-title') %>"><%= @title %></h1>
        <p class="<%= css('hero-subtitle') %>"><%= @subtitle %></p>

        <!-- CTA Button -->
        <% if @cta.present? %>
          <div class="<%= css('hero-cta') %>">
            <%= link_to @cta[:href], target: "_blank", class: css('hero-button'), aria: { label: "Contactar por WhatsApp" } do %>
              <%= render(UI::IconComponent.new(name: @cta[:icon], size: :medium, class_name: css('hero-button-icon'))) %>
              <span><%= @cta[:text] %></span>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Hero Image -->
      <% if @hero_image.present? %>
        <div class="<%= css('hero-image') %>" aria-hidden="true">
          <%= image_tag @hero_image[:src], alt: @hero_image[:alt], loading: 'lazy' %>
        </div>
      <% end %>
    </section>

    <!-- 2. Schedule Section -->
    <section class="<%= css('schedule') %>" aria-labelledby="<%= section_id('schedule-title') %>">
      <h2 id="<%= section_id('schedule-title') %>" class="<%= css('schedule-title') %>">Horarios y Grupos</h2>
      <div class="<%= css('schedule-details') %>">
        <article class="<%= css('schedule-card') %>" aria-labelledby="<%= section_id('schedule-card-title') %>">
          <header class="<%= css('schedule-header') %>">
            <h3 id="<%= section_id('schedule-card-title') %>" class="sr-only">Información de Horarios</h3>
            <div class="<%= css('schedule-age-groups') %>" role="group" aria-label="Grupos de edad">
              <!-- For Kids program these are fixed; other programs can style/hide via CSS if not applicable -->
              <div class="<%= css('age-group') %>">
                <span class="<%= css('group-name') %>">Kids I</span>
                <span class="<%= css('group-ages') %>">(5-8 años)</span>
              </div>
              <div class="<%= css('age-group') %>">
                <span class="<%= css('group-name') %>">Kids II</span>
                <span class="<%= css('group-ages') %>">(9-13 años)</span>
              </div>
            </div>
            <p class="<%= css('schedule-common-note') %> text-center">El siguiente horario aplica para ambos grupos.</p>
          </header>

          <div class="schedule-times">
            <h4 class="schedule-times-title sr-only">Horarios de Clase</h4>
            <ul class="<%= css('schedule-list') %>" role="list">
              <% @schedule.each do |slot| %>
                <li class="<%= css('schedule-item') %>">
                  <%= render(UI::IconComponent.new(name: 'calendar', size: :small, class_name: css('schedule-icon'), aria_label: nil)) %>
                  <span class="<%= css('schedule-day') %>"><%= slot[:day] %>:</span>
                  <span class="<%= css('schedule-time') %>"><%= slot[:time] %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </article>
      </div>
    </section>

    <!-- 3. Benefits Section -->
    <section class="<%= css('benefits') %>" aria-labelledby="<%= section_id('benefits-title') %>">
      <h2 id="<%= section_id('benefits-title') %>" class="<%= css('benefits-section-title') %>">Beneficios</h2>
      <div class="<%= css('benefits-grid') %>" role="list">
        <% @benefits.each_with_index do |benefit, idx| %>
          <article class="<%= css('benefit-card') %>" role="listitem" aria-labelledby="<%= section_id("benefit-#{idx}-title") %>">
            <div class="<%= css('benefit-icon') %>" aria-hidden="true">
              <%= render(UI::IconComponent.new(name: benefit[:icon], size: :large)) %>
            </div>
            <h3 id="<%= section_id("benefit-#{idx}-title") %>" class="<%= css('benefit-title') %>"><%= benefit[:title] %></h3>
            <p class="<%= css('benefit-text') %>"><%= benefit[:text] %></p>
          </article>
        <% end %>
      </div>
    </section>

    <!-- 4. Instructor Section(s) -->
    <% @instructors.each_with_index do |inst, i| %>
      <section class="<%= css('instructor') %>" aria-labelledby="<%= section_id("instructor-#{i+1}-title") %>">
        <div class="<%= css('instructor-image') %>">
          <%= image_tag inst[:image], alt: inst[:alt], loading: 'lazy' %>
        </div>
        <div class="<%= css('instructor-info') %>">
          <h2 id="<%= section_id("instructor-#{i+1}-title") %>" class="<%= css('instructor-title') %>"><%= inst[:title] %></h2>
          <p class="<%= css('instructor-name') %>"><%= inst[:name] %></p>
          <p class="<%= css('instructor-bio') %>"><%= inst[:bio] %></p>
        </div>
      </section>
    <% end %>

    <!-- Free Trial Component -->
    <%= render(UI::FreeTrialComponent.new) %>
  </div>
</div>
