<% if @href.present? %>
  <%= link_to @href, class: button_classes, disabled: @disabled, **@options do %>
    <%= render_icon %>
    <%= @text %>
  <% end %>
<% else %>
  <%= button_tag type: @options[:type] || 'button',
                 class: button_classes,
                 disabled: @disabled,
                 **@options do %>
    <%= render_icon %>
    <%= @text %>
  <% end %>
<% end %> 