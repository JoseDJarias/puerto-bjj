<section class="contact-container" aria-labelledby="contact-title">
  <header class="contact-header">
    <h2 id="contact-title" class="contact-title"><%= @title %></h2>
    <p class="contact-subtitle"><%= @subtitle %></p>
  </header>

  <div class="contact-content">
    <!-- Contact Info Cards -->
    <div class="contact-info" role="region" aria-labelledby="<%= contact_info_id %>">
      <h3 id="<%= contact_info_id %>" class="visually-hidden">Información de contacto</h3>
      <div class="contact-cards-grid">
        <% @contact_info.each_with_index do |info, index| %>
          <article class="contact-card" role="article" aria-labelledby="contact-card-<%= index %>">
            <header class="contact-card-header">
              <div class="contact-card-icon">
                <%= render(UI::IconComponent.new(
                  name: info[:icon],
                  size: :large,
                  aria_label: "#{info[:title]} icon"
                )) %>
              </div>
              <h4 id="contact-card-<%= index %>" class="contact-card-title"><%= info[:title] %></h4>
            </header>
            
            <div class="contact-card-content">
              <p class="contact-card-text"><%= info[:text] %></p>
              <% if info[:text_secondary].present? %>
                <p class="contact-card-text-secondary"><%= info[:text_secondary] %></p>
              <% end %>
              
              <% if info[:cta_text].present? %>
                <div class="contact-card-cta">
                  <%= render(UI::ButtonComponent.new(
                    variant: :plain,
                    text: info[:cta_text],
                    href: info[:cta_href],
                    icon: info[:cta_icon],
                    target: info[:target],
                    rel: info[:rel]
                  )) %>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </div>

    <!-- Feedback Modal -->      
    <div data-controller="modal" class="contact-feedback-cta" role="complementary" aria-labelledby="<%= feedback_cta_id %>">
      <h3 id="<%= feedback_cta_id %>" class="visually-hidden">Sección de feedback</h3>
      <div class="feedback-cta-content">
        <div class="feedback-cta-text">
          <h4 class="feedback-cta-title"><%= @feedback_cta[:title] %></h4>
          <p class="feedback-cta-description"><%= @feedback_cta[:text] %></p>
        </div>
        <button type="button" class="btn btn--primary feedback-cta-button" data-action="modal#showModal">
          <span class="feedback-cta-button-text"><%= @feedback_cta[:cta_text] %></span>
          <%= helpers.lucide_icon "mouse-pointer-click", class: "feedback-cta-button-icon" %>
        </button>
      </div>
      <dialog class="sheet sheet--right" data-modal-target="content" data-action="click->modal#closeOnClickOutside" aria-label="Feedback Form">
        <button type="button" class="sheet__close" data-action="modal#close" aria-label="Cerrar">
          <%= helpers.lucide_icon "x", class: "sheet__close-icon" %>
        </button>
        <div class="sheet__content">
          <%= render "feedbacks/form" %>
        </div>
      </dialog>
    </div>

  </div>
</section> 