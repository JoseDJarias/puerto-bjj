<section class="contact-social" aria-labelledby="social-links-title">
  <header class="social-links-header">
    <h3 id="social-links-title" class="contact-social-title"><%= @title %></h3>
    <h4 class="contact-social-title"><%= @subtitle %></h4>
    <p class="contact-social-subtitle"><%= @description %></p>
  </header>
  
  <nav class="social-links" role="navigation" aria-label="Enlaces de redes sociales">
    <% @social_links.each do |link| %>
      <%= render(ButtonComponent.new(
        variant: :plain,
        text: link[:name],
        href: link[:href],
        icon: link[:icon],
        target: link[:target],
        rel: link[:rel]
      )) %>
    <% end %>
  </nav>
</section> 