<section class="smoothcomp-container" aria-labelledby="smoothcomp-title">
  <header class="smoothcomp-header">
    <h2 id="smoothcomp-title" class="smoothcomp-title"><%= @title %></h2>
    <p class="smoothcomp-subtitle"><%= @subtitle %></p>
  </header>

  <article class="smoothcomp-card" role="article" aria-labelledby="smoothcomp-card-title">
    <header class="smoothcomp-card-header">
      <h3 id="smoothcomp-card-title" class="visually-hidden">Estadísticas de medallas</h3>
    </header>
    
    <div class="smoothcomp-stats" role="region" aria-labelledby="<%= stats_id %>">
      <h4 id="<%= stats_id %>" class="visually-hidden">Medallas obtenidas</h4>
      <div class="stats-grid">
        <% @stats.each_with_index do |stat, index| %>
          <div class="stat-item" role="listitem">
            <div class="stat-icon-wrapper">
              <%= render(IconComponent.new(
                name: stat[:icon],
                size: :custom,
                color: stat[:type],
                effects: :medal,
                class_name: "stat-medal-icon",
                aria_label: "#{stat[:count]} medallas de #{stat[:label].downcase}"
              )) %>
            </div>
            <div class="stat-content">
              <span class="stat-number" aria-label="<%= stat[:count] %> medallas de <%= stat[:label].downcase %>">
                <%= stat[:count] %>
              </span>
              <span class="stat-label"><%= stat[:label] %></span>
            </div>
          </div>
        <% end %>
      </div>
      
   
    </div>

    <footer class="smoothcomp-cta">
      <%= render(UI::ButtonComponent.new(
        variant: :primary,
        text: @cta_text,
        href: @cta_href,
        target: "_blank",
        rel: "noopener noreferrer"
      )) %>
    </footer>
  </article>
</section> 