<header class="sticky top-0 z-40 border-b border-bone/10 bg-ink/95 backdrop-blur" data-controller="menu" data-action="keydown.esc@window->menu#hide turbo:before-cache@document->menu#hide">
  <div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between gap-6 px-3.5 sm:px-6 lg:px-8">
    <%= link_to root_path, class: "flex items-center gap-3", aria: { label: t("academy.name") } do %>
      <%= image_tag "home/logo.png", alt: "", class: "h-9 w-9 object-contain" %>
      <span class="display text-2xl"><%= t("academy.name") %></span>
    <% end %>

    <nav class="hidden items-center gap-8 md:flex" aria-label="<%= t("nav.label") %>">
      <%= render "layouts/partials/nav_links", link_class: "text-xs font-bold uppercase tracking-widest transition-colors hover:text-blood" %>
    </nav>

    <div class="flex items-center gap-3">
      <%= link_to t("nav.contact_us"), Academy.whatsapp_url(t("academy.join_message")), target: "_blank", rel: "noopener noreferrer", class: "btn-primary hidden px-5 py-2.5 md:inline-flex" %>
      <button type="button" class="p-2 md:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="<%= t("nav.open_menu") %>" data-menu-target="button" data-action="menu#toggle">
        <span data-menu-target="openIcon"><%= lucide_icon "menu", class: "size-6" %></span>
        <span data-menu-target="closeIcon" hidden><%= lucide_icon "x", class: "size-6" %></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="overscroll-none border-t border-bone/10 bg-ink md:hidden" aria-label="<%= t("nav.label") %>" data-menu-target="panel" hidden>
    <div class="mx-auto flex w-full max-w-7xl flex-col px-3.5 py-4 sm:px-6">
      <%= render "layouts/partials/nav_links", link_class: "display border-b border-bone/10 py-4 text-3xl" %>
      <%= link_to t("nav.free_class"), Academy.whatsapp_url(t("academy.join_message")), target: "_blank", rel: "noopener noreferrer", class: "btn-primary mt-6" %>
    </div>
  </nav>
</header>
