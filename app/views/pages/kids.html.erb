<div class="kids-program-page">
  <!-- 1. Hero Section -->
  <div class="kids-program-page-container">
  <section class="kids-hero" aria-labelledby="kids-hero-title">
    <div class="kids-hero-content">
      <h1 id="hero-title-kids" class="kids-hero-title">Programa de Jiu-Jitsu para Niños</h1>
      <p class="kids-hero-subtitle">Formando campeones(as) dentro y fuera del tatami. Confianza, disciplina y respeto para toda una vida.</p>
    </div>
    <div class="kids-hero-image" aria-hidden="true">
      <%= image_tag 'home/kids-home-photo.jpeg', alt: 'Niños entrenando Jiu-Jitsu en Puerto BJJ', loading: 'lazy' %>
    </div>
  </section>

  <!-- 2. Schedule and Age Group Section -->
  <section class="kids-schedule" aria-labelledby="kids-schedule-title">
    <h2 id="hero-title-kids-schedule" class="kids-schedule-title">Horarios y Grupos</h2>
    <div class="kids-schedule-details">
      <article class="kids-schedule-card" aria-labelledby="schedule-card-title">
        <header class="kids-schedule-header">
          <h3 id="schedule-card-title" class="sr-only">Información de Horarios</h3>
          <div class="kids-schedule-age-groups" role="group" aria-label="Grupos de edad">
            <div class="kids-age-group">
              <span class="kids-group-name">Kids I</span>
              <span class="kids-group-ages">(5-8 años)</span>
            </div>
            <div class="kids-age-group">
              <span class="kids-group-name">Kids II</span>
              <span class="kids-group-ages">(9-13 años)</span>
            </div>
          </div>
          <p class="kids-schedule-common-note text-center">El siguiente horario aplica para ambos grupos.</p>
        </header>
        
        <div class="schedule-times">
          <h4 class="schedule-times-title sr-only">Horarios de Clase</h4>
          <ul class="kids-schedule-list" role="list">
            <li class="kids-schedule-item">
              <%= lucide_icon "calendar", class: "kids-schedule-icon", "aria-hidden": "true" %>
              <span class="kids-schedule-day">Lunes:</span>
              <span class="kids-schedule-time">5:00 PM - 6:00 PM</span>
            </li>
            <li class="kids-schedule-item">
              <%= lucide_icon "calendar", class: "kids-schedule-icon", "aria-hidden": "true" %>
              <span class="kids-schedule-day">Sábado:</span>
              <span class="kids-schedule-time">9:30 AM - 10:30 AM</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </section>

  <!-- 3. Benefits Section -->
  <section class="kids-benefits" aria-labelledby="kids-benefits-title">
    <h2 id="benefits-kids-section-title" class="kids-benefits-section-title">Beneficios</h2>
    <div class="kids-benefits-grid" role="list">
      <article class="kids-benefit-card" role="listitem" aria-labelledby="benefit-confidence-title">
        <div class="kids-benefit-icon" aria-hidden="true">
          <%= lucide_icon "shield", class: "" %>
        </div>
        <h3 id="benefit-confidence-title" class="kids-benefit-title">Confianza y Autoestima</h3>
        <p class="kids-benefit-text">Aprenderán a superar retos, y por tanto a mejorar su confianza en sí mismo.</p>
      </article>
      
      <article class="kids-benefit-card" role="listitem" aria-labelledby="benefit-discipline-title">
        <div class="kids-benefit-icon" aria-hidden="true">
          <%= lucide_icon "heart", class: "" %>
        </div>
        <h3 id="benefit-discipline-title" class="kids-benefit-title">Disciplina y Respeto</h3>
        <p class="kids-benefit-text">Incentivamos valores fundamentales que les servirán en la escuela y en la vida.</p>
      </article>
      
      <article class="kids-benefit-card" role="listitem" aria-labelledby="benefit-fitness-title">
        <div class="kids-benefit-icon" aria-hidden="true">
          <%= lucide_icon "dumbbell", class: "" %>
        </div>
        <h3 id="benefit-fitness-title" class="kids-benefit-title">Condición Física</h3>
        <p class="kids-benefit-text">Mejorarán su coordinación, fuerza y agilidad en un ambiente divertido y seguro.</p>
      </article>
      
      <article class="kids-benefit-card" role="listitem" aria-labelledby="benefit-mental-title">
        <div class="kids-benefit-icon" aria-hidden="true">
          <%= lucide_icon "brain-circuit", class: "" %>
        </div>
        <h3 id="benefit-mental-title" class="kids-benefit-title">Salud Mental</h3>
        <p class="kids-benefit-text">El Jiu-Jitsu reduce el estrés y la ansiedad, mejorando el enfoque y la claridad mental.</p>
      </article>
      
      <article class="kids-benefit-card" role="listitem" aria-labelledby="benefit-social-title">
        <div class="kids-benefit-icon" aria-hidden="true">
          <%= lucide_icon "users", class: "" %>
        </div>
        <h3 id="benefit-social-title" class="kids-benefit-title">Habilidades Sociales</h3>
        <p class="kids-benefit-text">Harán nuevos amigos y aprenderán a trabajar en equipo y a apoyarse mutuamente.</p>
      </article>
    </div>
  </section>

  <!-- 4. Instructor Section -->
  <section class="kids-instructor" aria-labelledby="kids-instructor-kevin-title">
    <div class="kids-instructor-image">
      <%= image_tag 'programs/kids-instructor-1.jpg', alt: 'Kevin Matarrita Lara - Instructor Principal del Programa Kids', loading: 'lazy' %>
    </div>
    <div class="kids-instructor-info">
      <h2 id="kids-instructor-kevin-title" class="kids-instructor-title">Conoce a Nuestro Instructor Principal</h2>
      <p class="kids-instructor-name">Kevin Matarrita Lara</p>
      <p class="kids-instructor-bio">
        Con más de 10 años de experiencia en Jiu-Jitsu y una gran pasión por la enseñanza, 
        nuestro instructor principal del programa Kids está certificado y dedicado a crear un ambiente 
        de aprendizaje positivo y seguro. Su objetivo es que cada niño alcance su potencial.
      </p>
    </div>
  </section>
  
  <section class="kids-instructor" aria-labelledby="kids-instructor-daniel-title">
    <div class="kids-instructor-image">
      <%= image_tag 'programs/kids-instructor-2.jpg', alt: 'Jose Daniel Arias - Instructor Asistente del Programa Kids', loading: 'lazy' %>
    </div>
    <div class="kids-instructor-info">
      <h2 id="kids-instructor-daniel-title" class="kids-instructor-title">Conoce a Nuestro Instructor-Asistente</h2>
      <p class="kids-instructor-name">Jose Daniel Arias</p>
      <p class="kids-instructor-bio">
        Con más de 4 años de experiencia en Jiu-Jitsu, un gran entusiasmo y mucha capacidad de complementar el
        trabajo en equipo, su rol es fundamental para el desarrollo individual de los alumnos, 
        ofreciendo apoyo constante y asegurando que nadie se quede atrás.
      </p>
    </div>
  </section>

  <!-- Free Trial Component -->
  <%= render(FreeTrialComponent.new) %>
  </div>
</div> 