<% content_for :title, "#{t("meta.about_title")} | #{t("meta.title")}" %>
<% content_for :description, t("meta.about_description") %>

<section aria-labelledby="about-title">
  <p class="eyebrow"><%= t("about.eyebrow") %></p>
  <h1 id="about-title" class="display mt-5 text-6xl sm:text-8xl lg:text-9xl"><%= t("about.title") %></h1>
  <p class="mt-6 max-w-xl text-lg text-bone/70"><%= t("about.lead") %></p>
</section>

<section class="grid gap-10 lg:grid-cols-3" aria-labelledby="history-title">
  <h2 id="history-title" class="display text-4xl lg:text-5xl"><%= t("about.history_title") %></h2>
  <p class="text-lg leading-relaxed text-bone/80 lg:col-span-2"><%= t("about.history_text") %></p>
</section>

<section class="grid gap-10 lg:grid-cols-3" aria-labelledby="mission-title">
  <h2 id="mission-title" class="display text-4xl lg:text-5xl"><%= t("about.mission_title") %></h2>
  <p class="text-lg leading-relaxed text-bone/80 lg:col-span-2"><%= t("about.mission_text") %></p>
</section>

<section aria-labelledby="values-title">
  <h2 id="values-title" class="sr-only"><%= t("about.values_title") %></h2>
  <ol class="grid gap-px border border-bone/15 bg-bone/15 md:grid-cols-3">
    <% t("about.values").each_with_index do |value, index| %>
      <li class="bg-ink p-6 lg:p-8">
        <span class="display text-2xl text-blood"><%= format("%02d", index + 1) %></span>
        <h3 class="display mt-3 text-3xl"><%= value[:title] %></h3>
        <p class="mt-3 text-bone/70"><%= value[:text] %></p>
      </li>
    <% end %>
  </ol>
</section>

<section aria-labelledby="team-title">
  <header class="mb-8 max-w-2xl">
    <h2 id="team-title" class="display text-4xl lg:text-5xl"><%= t("about.team_title") %></h2>
    <p class="mt-4 text-bone/70"><%= t("about.team_text") %></p>
  </header>
  <div class="grid gap-8 md:grid-cols-2">
    <% @instructors.each do |instructor| %>
      <%= render "pages/partials/instructor", instructor: instructor %>
    <% end %>
  </div>
</section>

<section class="bg-blood p-8 lg:p-14" aria-labelledby="about-cta-title">
  <h2 id="about-cta-title" class="display max-w-3xl text-4xl sm:text-6xl"><%= t("about.cta_title") %></h2>
  <p class="mt-4 max-w-xl text-bone/90"><%= t("about.cta_text") %></p>
  <%= link_to Academy.whatsapp_url(t("academy.join_message")), target: "_blank", rel: "noopener noreferrer", class: "mt-8 inline-flex items-center gap-2 bg-ink px-6 py-4 text-sm font-bold uppercase tracking-wider transition-colors hover:bg-bone hover:text-ink" do %>
    <%= t("about.cta") %><%= lucide_icon "arrow-up-right", class: "size-5" %>
  <% end %>
</section>
