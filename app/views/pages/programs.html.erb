<% content_for :title, t("meta.programs_title") %>
<% content_for :description, t("meta.programs_description") %>

<section aria-labelledby="programs-page-title" style="margin-bottom: 0px">
  <p class="eyebrow"><%= t("programs_page.eyebrow") %></p>
  <h1 id="programs-page-title" class="display mt-5 text-6xl sm:text-8xl lg:text-9xl"><%= t("programs_page.title") %></h1>
  <p class="mt-6 max-w-xl text-lg text-bone/70"><%= t("programs_page.lead") %></p>
</section>

<section class="space-y-px bg-bone/15" aria-label="<%= t("programs_page.title") %>">
  <% @programs.each_with_index do |program, index| %>
    <article class="grid gap-6 bg-ink py-8 lg:grid-cols-2 lg:gap-12">
      <div class="aspect-[4/3] overflow-hidden <%= "lg:order-2" if index.odd? %>">
        <%= image_tag program.image, alt: program.title, class: "size-full object-cover grayscale contrast-125 transition duration-500 hover:grayscale-0", loading: "lazy" %>
      </div>
      <div class="flex flex-col justify-center">
        <p class="display text-xl text-blood"><%= format("%02d", index + 1) %></p>
        <h2 class="display mt-2 text-5xl sm:text-6xl"><%= program.title %></h2>
        <p class="mt-4 max-w-md text-bone/70"><%= program.subtitle %></p>
        <%= link_to program_path(program), class: "btn-ghost mt-8 w-fit" do %>
          <%= t("programs_page.view") %><%= lucide_icon "arrow-up-right", class: "size-5" %>
        <% end %>
      </div>
    </article>
  <% end %>
</section>
