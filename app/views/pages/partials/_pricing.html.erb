<section id="precios" class="relative overflow-hidden" aria-labelledby="pricing-title"
         data-controller="section-toggle"
         data-section-toggle-open-value="false"
         data-section-toggle-open-text-value="<%= t("home.section_collapse.pricing_open") %>"
         data-section-toggle-close-text-value="<%= t("home.section_collapse.pricing_close") %>">

  <%# Trazos geométricos sutiles de olas japonesas (Seigaiha / Olas de Puerto) de fondo %>
  <div class="pointer-events-none absolute -right-20 -top-20 -z-10 h-96 w-96 opacity-[0.04] sm:opacity-[0.06] select-none" aria-hidden="true">
    <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" class="size-full text-bone">
      <defs>
        <pattern id="puerto-waves" x="0" y="0" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 0 40 A 20 20 0 0 1 40 40 M -20 40 A 20 20 0 0 1 20 40 M 20 40 A 20 20 0 0 1 60 40" stroke="currentColor" stroke-width="1.2" fill="none"/>
          <path d="M 0 20 A 20 20 0 0 1 40 20 M -20 20 A 20 20 0 0 1 20 20 M 20 20 A 20 20 0 0 1 60 20" stroke="currentColor" stroke-width="1.2" fill="none"/>
          <path d="M 0 0 A 20 20 0 0 1 40 0 M -20 0 A 20 20 0 0 1 20 0 M 20 20 A 20 20 0 0 1 60 0" stroke="currentColor" stroke-width="1.2" fill="none"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#puerto-waves)" />
    </svg>
  </div>

  <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
    <div>
      <%= render "pages/partials/section_heading", id: "pricing-title", eyebrow: t("home.pricing_eyebrow"), title: t("home.pricing_title") %>
    </div>
    
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
      <%# Botón/control de cierre cuando está abierto en mobile %>
      <div class="lg:hidden hidden" data-section-toggle-target="closeButtonWrapper">
        <button type="button"
                class="btn-ghost w-full inline-flex items-center justify-center gap-2 py-3 px-5 text-xs"
                data-action="section-toggle#toggle">
          <span data-section-toggle-target="buttonText"><%= t("home.section_collapse.pricing_close") %></span>
          <%= lucide_icon "chevron-up", class: "size-4" %>
        </button>
      </div>

      <div class="hidden sm:flex items-center gap-2 border border-bone/15 bg-bone/5 px-3 py-1.5 self-start sm:self-auto" title="<%= t("academy.name") %>">
        <svg class="size-5 text-blood" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12c2-2.5 4-3 7-1s5 2.5 7 0 4-3 6-1" />
          <path d="M2 17c2-2.5 4-3 7-1s5 2.5 7 0 4-3 6-1" />
        </svg>
        <span class="text-[11px] font-bold uppercase tracking-widest text-bone/70"><%= t("home.pricing_location_badge") %></span>
      </div>
    </div>
  </div>

  <%# Tarjeta interactiva completa cuando está cerrada en mobile %>
  <div class="lg:hidden mb-6" data-section-toggle-target="teaserBadge">
    <button type="button"
            class="group w-full text-left border border-bone/20 bg-bone/[0.03] p-5 transition-all hover:border-blood hover:bg-bone/[0.06] active:scale-[0.99] focus-visible:outline-2 focus-visible:outline-blood"
            data-action="section-toggle#toggle"
            aria-expanded="false">
      <div class="flex items-start gap-4">
        <div class="p-3 border border-blood bg-blood/10 text-blood shrink-0 transition-colors group-hover:bg-blood group-hover:text-bone">
          <%= lucide_icon "badge-percent", class: "size-6" %>
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-base font-bold text-bone group-hover:text-blood transition-colors">
              <%= t("home.section_collapse.pricing_teaser_title") %>
            </h3>
            <%= lucide_icon "arrow-down-right", class: "size-5 text-bone/40 shrink-0 transition-transform group-hover:translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-blood" %>
          </div>
          <p class="mt-1 text-xs text-bone/65 leading-relaxed">
            <%= t("home.section_collapse.pricing_teaser_desc") %>
          </p>
        </div>
      </div>

      <%# Botón primario integrado dentro de la misma tarjeta %>
      <div class="mt-4 pt-4 border-t border-bone/10">
        <div class="btn-primary w-full text-center text-xs py-3 pointer-events-none">
          <span><%= t("home.section_collapse.pricing_open") %></span>
          <%= lucide_icon "chevron-down", class: "size-4" %>
        </div>
      </div>
    </button>
  </div>

  <%# Contenido de la sección de precios %>
  <div data-section-toggle-target="content" class="hidden lg:block space-y-12">
    <%
      package_keys = [ :complete, :bjj_box_mma, :bjj_mma, :box_mma, :mma, :kids, :students, :police ]
    %>

    <div class="grid gap-px border border-bone/15 bg-bone/15 md:grid-cols-2 lg:grid-cols-4">
      <% package_keys.each do |key| %>
        <%
          name = t("home.packages.#{key}.name")
          badge = t("home.packages.#{key}.badge", default: nil)
          desc = t("home.packages.#{key}.desc")
          monthly_price = t("home.packages.#{key}.monthly")
          bimonthly_price = t("home.packages.#{key}.bimonthly")
          quarterly_price = t("home.packages.#{key}.quarterly")
          save_info = t("home.packages.#{key}.save_info", default: nil)
          wa_msg = t("home.packages.#{key}.whatsapp_message")
          is_highlighted = (key == :complete)
        %>
        <article class="relative flex flex-col justify-between bg-ink p-6 transition-colors hover:bg-bone/[0.03] lg:p-7 <%= is_highlighted ? 'ring-1 ring-blood' : '' %>">
          <% if badge.present? %>
            <% if is_highlighted %>
              <div class="absolute -top-3 right-6 bg-blood px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-bone">
                <%= badge %>
              </div>
            <% else %>
              <div class="mb-3 inline-block">
                <span class="text-[10px] font-bold uppercase tracking-wider text-bone/60 border border-bone/20 px-2 py-0.5">
                  <%= badge %>
                </span>
              </div>
            <% end %>
          <% end %>

          <div>
            <h3 class="display text-2xl sm:text-3xl <%= is_highlighted ? 'text-blood' : 'text-bone' %>">
              <%= name %>
            </h3>
            <p class="mt-2 text-xs text-bone/65 min-h-[2rem]">
              <%= desc %>
            </p>

            <div class="mt-6 divide-y divide-bone/10 border-y border-bone/10">
              <div class="flex items-baseline justify-between py-2.5">
                <span class="text-xs font-medium uppercase tracking-wider text-bone/60"><%= t("home.monthly") %></span>
                <span class="text-lg font-bold text-bone"><%= monthly_price %></span>
              </div>
              <div class="flex items-baseline justify-between py-2.5">
                <span class="text-xs font-medium uppercase tracking-wider text-bone/60"><%= t("home.bimonthly") %></span>
                <span class="text-base font-semibold text-bone/90"><%= bimonthly_price %></span>
              </div>
              <div class="flex items-baseline justify-between py-2.5">
                <span class="text-xs font-medium uppercase tracking-wider text-bone/60"><%= t("home.quarterly") %></span>
                <span class="text-base font-semibold text-bone/90"><%= quarterly_price %></span>
              </div>
            </div>

            <% if save_info.present? %>
              <p class="mt-3 text-[11px] font-medium text-blood/90 flex items-center gap-1.5">
                <span class="inline-block size-1 rounded-full bg-blood"></span>
                <%= save_info %>
              </p>
            <% end %>
          </div>

          <div class="mt-6 pt-4 border-t border-bone/10">
            <%= link_to Academy.whatsapp_url(wa_msg), target: "_blank", rel: "noopener noreferrer", class: is_highlighted ? "btn-primary w-full text-center text-xs py-3" : "btn-ghost w-full text-center text-xs py-3" do %>
              <span><%= t("home.pricing_choose_plan") %></span>
              <%= lucide_icon "arrow-up-right", class: "size-4" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <%# Sección Clases Privadas (1 a 1) %>
    <div class="border border-bone/15 bg-bone/5 p-6 lg:p-10 relative overflow-hidden">
      <div class="pointer-events-none absolute -bottom-10 -right-10 opacity-5 select-none" aria-hidden="true">
        <svg class="size-64 text-bone" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1">
          <circle cx="50" cy="50" r="45" stroke-dasharray="2 3"/>
          <circle cx="50" cy="50" r="30"/>
          <circle cx="50" cy="50" r="15"/>
        </svg>
      </div>

      <div class="relative z-10 grid gap-8 lg:grid-cols-3 lg:items-center">
        <div>
          <span class="eyebrow"><%= t("home.private_classes.eyebrow") %></span>
          <h3 class="display mt-2 text-3xl sm:text-4xl text-bone"><%= t("home.private_classes.title") %></h3>
          <p class="mt-3 text-sm text-bone/70 leading-relaxed">
            <%= t("home.private_classes.subtitle") %>
          </p>
          <%= link_to Academy.whatsapp_url(t("home.private_classes.whatsapp_message")), target: "_blank", rel: "noopener noreferrer", class: "btn-primary mt-6 text-xs py-3 px-5" do %>
            <span><%= t("home.private_classes.cta") %></span>
            <%= lucide_icon "message-circle", class: "size-4" %>
          <% end %>
        </div>

        <div class="lg:col-span-2 grid gap-px border border-bone/15 bg-bone/15 sm:grid-cols-3">
          <%# 1 Clase %>
          <div class="bg-ink p-5 flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-bone/60"><%= t("home.private_classes.single.name") %></span>
              <div class="mt-4 flex items-baseline gap-1">
                <span class="display text-3xl sm:text-4xl text-blood"><%= t("home.private_classes.single.price") %></span>
              </div>
              <p class="mt-2 text-xs text-bone/60"><%= t("home.private_classes.single.desc") %></p>
            </div>
            <span class="mt-4 text-[11px] text-bone/40 uppercase tracking-wider"><%= t("home.private_classes.single.tag") %></span>
          </div>

          <%# Paquete 8 Clases %>
          <div class="bg-ink p-5 flex flex-col justify-between border-t sm:border-t-0 border-bone/10">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-bone/60"><%= t("home.private_classes.pack_8.name") %></span>
              <div class="mt-4 flex items-baseline gap-1">
                <span class="display text-3xl sm:text-4xl text-bone"><%= t("home.private_classes.pack_8.price") %></span>
              </div>
              <p class="mt-2 text-xs text-bone/60"><%= t("home.private_classes.pack_8.desc") %></p>
            </div>
            <span class="mt-4 text-[11px] font-bold text-blood uppercase tracking-wider"><%= t("home.private_classes.pack_8.savings") %></span>
          </div>

          <%# Paquete 10 Clases %>
          <div class="bg-ink p-5 flex flex-col justify-between border-t sm:border-t-0 border-bone/10">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-bone/60"><%= t("home.private_classes.pack_10.name") %></span>
              <div class="mt-4 flex items-baseline gap-1">
                <span class="display text-3xl sm:text-4xl text-bone"><%= t("home.private_classes.pack_10.price") %></span>
              </div>
              <p class="mt-2 text-xs text-bone/60"><%= t("home.private_classes.pack_10.desc") %></p>
            </div>
            <span class="mt-4 text-[11px] font-bold text-blood uppercase tracking-wider"><%= t("home.private_classes.pack_10.savings") %></span>
          </div>
        </div>
      </div>
    </div>

    <%# Nota informativa inferior %>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-l-2 border-blood bg-bone/[0.03] px-6 py-4">
      <p class="text-xs sm:text-sm text-bone/70">
        <%= t("home.pricing_note") %>
      </p>
      <%= link_to Academy.whatsapp_url(t("academy.join_message")), target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest text-blood hover:text-bone transition-colors shrink-0" do %>
        <%= t("home.pricing_cta") %>
        <%= lucide_icon "chevron-right", class: "size-4" %>
      <% end %>
    </div>
  </div>
</section>
