<section class="grid items-center gap-10 md:grid-cols-12 lg:gap-14" aria-labelledby="hero-title">
  <div class="md:col-span-6 lg:col-span-7">
    <p class="eyebrow"><%= t("home.eyebrow") %></p>
    <% phrase = weekly_phrase %>
    <h1 id="hero-title" class="display mt-4 text-5xl sm:text-7xl lg:text-[7rem] xl:text-[8rem]">
      <%= phrase[:white] %>
      <span class="text-blood"><%= phrase[:red] %></span>
    </h1>
    <p class="mt-5 max-w-lg text-base text-bone/70 sm:text-lg"><%= t("home.lead") %></p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <%= link_to Academy.whatsapp_url(t("academy.join_message")), target: "_blank", rel: "noopener noreferrer", class: "btn-primary" do %>
        <%= t("home.cta_primary") %><%= lucide_icon "arrow-up-right", class: "size-5" %>
      <% end %>
      <%= link_to t("home.cta_secondary"), programs_path, class: "btn-ghost" %>
    </div>
  </div>

  <div class="md:col-span-6 lg:col-span-5">
    <%= render "pages/partials/carousel", slides: slides %>
  </div>
</section>
