<header>
  <div class="header-wrapper">
    <div class="styled-header flex justify-between items-center"
         data-controller="sticky-hide-header"
         data-sticky-hide-header-target="header">
      <div class="header-left flex items-center justify-start mi-6" style="flex: 1;">
        <%= link_to root_path, class: "header-logo" do %>
          <%= image_tag 'home/logo.svg', alt: 'Puerto Jiu-Jitsu Logo', class: 'header-logo-image' %>
        <% end %>
      </div>

    <div class="show@md flex-grow text-center text-xl flex justify-center items-center gap-4 center-navigation">
      <!-- <div class="header-dropdown" data-controller="dropdown">
        <%= link_to programs_path, class: "rounded p-4 header-dropdown-trigger" do %>
          <span>Programas</span>
          <%= lucide_icon('chevron-down', size: 20, "data-action": "click->dropdown#toggle") %>
        <% end %>
        <div class="header-dropdown-menu hidden" data-dropdown-target="menu">
        <%= link_to "Todos los Programas", programs_path, class: "hover:underline" %>
        <%= link_to "Programa de Niños", program_path(:kids), class: "hover:underline" %>        </div>
      </div> -->
    </div>

      <div class="header-right flex items-center justify-end mi-8" style="flex: 1;">
        <div class="show@lg header-social-link-container">
          <%= link_to "https://www.facebook.com/puertojiujitsu/", target: "_blank", class: "header-social-link", aria: { label: "Facebook" } do %>
            <%= lucide_icon "facebook", class: "" %>
          <% end %>
          <%= link_to "https://www.instagram.com/puertojiujitsu/", target: "_blank", class: "header-social-link", aria: { label: "Instagram" } do %>
            <%= lucide_icon "instagram", class: "" %>
          <% end %>
          <%= link_to "https://wa.me/50672026863", target: "_blank", class: "header-social-link", aria: { label: "WhatsApp" } do %>
            <%= lucide_icon "message-circle", class: "" %>
          <% end %>
          <%= link_to "https://www.google.com/maps/place/Gimnasio+In+Line/@9.9831961,-84.7348988,17z", target: "_blank", class: "header-social-link", aria: { label: "Google Maps" } do %>
            <%= lucide_icon "map-pin", class: "" %>
          <% end %>
        </div>

        <div class="cursor-grab ham-menu mr-4"
             data-controller="mobile-menu"
             data-action="click->mobile-menu#toggle"
             data-mobile-menu-target="trigger"
             data-menu-id="mobile-menu">
          <%= lucide_icon('square-menu', width: 50, height: 50) %>
        </div>
      </div>

      <div id="mobile-menu" class="mobile-menu-overlay hidden" data-controller="modal">
        <nav class="flex flex-col text-base gap mobile-menu-overlay-nav">
          <%= link_to "Inicio", root_path, class: "hover:underline" %>
          <%= link_to "Todos los Programas", programs_path, class: "hover:underline" %>
          <%= link_to "Programa de Niños", program_path(:kids), class: "hover:underline" %>
          <%= link_to "Sobre Nosotros", about_us_path, class: "hover:underline" %>
          <button type="button" class="mobile-menu-feedback-btn" data-action="modal#showModal mobile-menu#close">
            <%= lucide_icon "message-square", class: "mobile-menu-feedback-icon" %>
            <span>Feedback</span>
          </button>
        </nav>

        <dialog class="sheet sheet--right" data-modal-target="content" data-action="click->modal#closeOnClickOutside" aria-label="Feedback Form">
          <button type="button" class="sheet__close" data-action="modal#close" aria-label="Cerrar">
            <%= lucide_icon "x", class: "sheet__close-icon" %>
          </button>
          <div class="sheet__content">
            <%= render "feedbacks/form" %>
          </div>
        </dialog>
      </div>
    </div>
  </div>
</header>