<turbo-frame id="feedback-form-frame">
  <div class="feedback-modal-wrapper feedback-result feedback-success">
    <div class="feedback-result-icon feedback-success-icon">
      <%= lucide_icon "circle-check", class: "feedback-result-svg" %>
    </div>
    <h2 class="feedback-result-title">¡Gracias por tu feedback!</h2>
    <p class="feedback-result-message">Tu opinión es muy importante para nosotros. Hemos recibido tu mensaje correctamente.</p>
    <button type="button" class="btn btn--primary" data-action="modal#close">Cerrar</button>
  </div>
</turbo-frame>

