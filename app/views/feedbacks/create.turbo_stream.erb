    <div class="flex flex-col items-center justify-center full-size gap">
      <h2 class="text-2xl font-bold">¡Gracias por tu mensaje!</h2>
      <p class="">Tu opinión nos ayuda a mejorar 🥋</p>

      <%= link_to "Seguir explorando",
            root_path,
            form: { data: { turbo_frame: "_top" } }, 
            class: "btn btn--primary"
      %>
    </div>
  </template>
</turbo-stream>