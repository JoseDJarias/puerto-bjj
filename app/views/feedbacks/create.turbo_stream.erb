<turbo-stream action="replace" target="feedback_container">
  <template>
    <div class="create-feedback-container text-center bg-positive p-6 rounded shadow">
      <h2 class="text-2xl font-bold">¡Gracias por tu mensaje!</h2>
      <p class="">Tu opinión nos ayuda a mejorar 🥋</p>

      <%= link_to "Enviar otro comentario ",
            feedback_path,
            form: { data: { turbo_frame: "_top" } }, 
            class: "btn",
            style:  "cursor:grab"
      %>
    </div>
  </template>
</turbo-stream>